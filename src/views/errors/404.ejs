<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Không tìm thấy</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
  <main class="container min-vh-100 d-flex align-items-center justify-content-center">
    <section class="text-center bg-white border rounded p-5 shadow-sm" style="max-width: 560px;">
      <div class="display-1 fw-bold text-primary">404</div>
      <h1 class="h3 mb-3">Không tìm thấy nội dung</h1>
      <p class="text-muted mb-4"><%= typeof message !== 'undefined' ? message : 'Trang bạn đang tìm không tồn tại.' %></p>
      <a href="/" class="btn btn-primary">Về trang chủ</a>
    </section>
  </main>
</body>
</html>
