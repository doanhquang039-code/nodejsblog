<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= post.title %> - <%= siteName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>
  <main class="container py-5">
    <a href="/" class="btn btn-outline-secondary mb-4">Quay lại trang chủ</a>

    <article class="mx-auto" style="max-width: 860px;">
      <div class="mb-4">
        <span class="badge text-bg-success"><%= post.category ? post.category.name : 'Chưa phân loại' %></span>
        <span class="text-muted ms-2"><%= post.author ? post.author.name : 'Ẩn danh' %></span>
      </div>

      <h1 class="display-5 fw-bold mb-4"><%= post.title %></h1>

      <% if (post.video) { %>
        <video class="w-100 rounded mb-4 bg-dark" controls poster="<%= post.image || '' %>">
          <source src="<%= post.video %>" type="video/mp4">
        </video>
      <% } else if (post.image) { %>
        <img src="<%= post.image %>" alt="<%= post.title %>" class="img-fluid rounded mb-4">
      <% } %>

      <div class="fs-5 lh-lg mb-5" style="white-space: pre-wrap;"><%= post.content %></div>

      <% if (post.tags && post.tags.length) { %>
        <div class="d-flex flex-wrap gap-2 mb-5">
          <% post.tags.forEach(tag => { %>
            <span class="badge text-bg-light border">#<%= tag.name %></span>
          <% }) %>
        </div>
      <% } %>

      <section class="border-top pt-4">
        <h2 class="h4 mb-3">Bình luận</h2>
        <% if (post.comments && post.comments.length) { %>
          <% post.comments.forEach(comment => { %>
            <div class="border rounded p-3 mb-3">
              <strong><%= comment.author ? comment.author.name : 'Ẩn danh' %></strong>
              <p class="mb-0 mt-2"><%= comment.content %></p>
            </div>
          <% }) %>
        <% } else { %>
          <p class="text-muted">Chưa có bình luận nào.</p>
        <% } %>
      </section>
    </article>
  </main>
</body>
</html>
