<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof siteName !== 'undefined' ? siteName : 'My Blog Node.js' %></title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  </head>
  <body>
    <nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom">
      <div class="container">
        <a class="navbar-brand fw-bold" href="/">My Blog</a>
        <div class="d-flex gap-2">
          <a href="/login" class="btn btn-outline-primary">Đăng nhập</a>
          <a href="/register" class="btn btn-primary">Đăng ký</a>
        </div>
      </div>
    </nav>

    <main class="container py-5">
      <div class="mb-5">
        <h1 class="display-5 fw-bold">Bài viết mới nhất</h1>
        <p class="lead text-muted">Theo dõi các bài viết đã được công khai trên hệ thống.</p>
      </div>

      <% const publishedPosts = typeof posts !== 'undefined' ? posts : []; %>
      <% if (publishedPosts.length) { %>
        <div class="row g-4">
          <% publishedPosts.forEach(post => { %>
            <div class="col-md-6 col-lg-4">
              <article class="card h-100 shadow-sm">
                <% if (post.image) { %>
                  <img src="<%= post.image %>" class="card-img-top" alt="<%= post.title %>" style="height: 210px; object-fit: cover;">
                <% } %>
                <div class="card-body d-flex flex-column">
                  <div class="small text-muted mb-2">
                    <%= post.category ? post.category.name : 'Chưa phân loại' %>
                    ·
                    <%= post.author ? post.author.name : 'Ẩn danh' %>
                  </div>
                  <h2 class="h5 card-title"><%= post.title %></h2>
                  <p class="card-text text-muted flex-grow-1"><%= post.content.slice(0, 140) %><%= post.content.length > 140 ? '...' : '' %></p>
                  <a href="/post/<%= post.slug %>" class="btn btn-outline-primary mt-3">Đọc bài viết</a>
                </div>
              </article>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="text-center border rounded p-5 bg-light">
          <h2 class="h4">Chưa có bài viết công khai</h2>
          <p class="text-muted mb-0">Các bài đã duyệt sẽ hiển thị tại đây.</p>
        </div>
      <% } %>
    </main>
  </body>
</html>
