<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kết quả tìm kiếm - My Blog</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>
  <main class="container py-5">
    <div class="mb-4">
      <a href="/" class="btn btn-outline-secondary mb-3">Trang chủ</a>
      <h1 class="fw-bold">Kết quả tìm kiếm</h1>
      <p class="text-muted">Từ khóa: <strong><%= query %></strong> · <%= total || 0 %> kết quả</p>
    </div>

    <% if (posts && posts.length) { %>
      <div class="row g-4">
        <% posts.forEach(post => { %>
          <div class="col-md-6">
            <article class="border rounded p-4 h-100">
              <div class="small text-muted mb-2">
                <%= post.category ? post.category.name : 'Chưa phân loại' %>
              </div>
              <h2 class="h4"><%= post.title %></h2>
              <p class="text-muted"><%= post.content.slice(0, 180) %><%= post.content.length > 180 ? '...' : '' %></p>
              <a href="/post/<%= post.slug %>" class="btn btn-primary">Đọc bài viết</a>
            </article>
          </div>
        <% }) %>
      </div>

      <div class="mt-4 text-muted">Trang <%= page %> / <%= pages || 1 %></div>
    <% } else { %>
      <div class="border rounded bg-light p-5 text-center">
        <h2 class="h4">Không tìm thấy bài viết phù hợp</h2>
        <p class="text-muted mb-0">Thử tìm bằng từ khóa khác.</p>
      </div>
    <% } %>
  </main>
</body>
</html>
